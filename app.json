{
  "expo": {
    "name": "Bits",
    "slug": "bits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bits",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.shudio.bits",
      "supportsTablet": true,
      "icon": {
        "dark": "./assets/images/ios-dark.png",
        "light": "./assets/images/ios-light.png",
        "tinted": "./assets/images/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shudio.bits"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-light.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "HeatmapWidget",
              "displayName": "Weekly Heatmap",
              "description": "Shows your habit completion heatmap for the last 7 days",
              "supportedFamilies": ["systemMedium"],
              "contentMarginsDisabled": true
            },
            {
              "name": "DailyProgressWidget",
              "displayName": "Today's Progress",
              "description": "Shows your habit completion progress for today",
              "supportedFamilies": ["systemSmall"],
              "contentMarginsDisabled": true
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Geist-Bold.ttf",
            "./assets/fonts/Geist-SemiBold.ttf",
            "./assets/fonts/Geist-Medium.ttf"
          ],
          "widgets": [
            {
              "name": "HeatmapWidget",
              "label": "Weekly Heatmap",
              "description": "Shows your habit completion heatmap for the last 7 days",
              "minWidth": "320dp",
              "minHeight": "140dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2
            },
            {
              "name": "DailyProgressWidget",
              "label": "Today's Progress",
              "description": "Shows your habit completion progress for today",
              "minWidth": "140dp",
              "minHeight": "140dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2
            }
          ]
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
